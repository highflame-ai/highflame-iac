# Highflame air-gapped evaluation — the only file you need to edit.
#
# The same steps on Linux, macOS and Windows:
#
#   1. Copy this file to .env and set HIGHFLAME_HOST_IP and
#      HIGHFLAME_LLM_BASE_URL below. (If .env does not exist, step 2 creates it
#      from this file and stops, asking for those two values.)
#   2. docker compose -f bootstrap.yaml run --rm bootstrap   # fills in GENERATED
#   3. docker compose up -d                  # starts the stack, seeds the tenant
#
# Nothing here is sent anywhere. There is no licence server, no telemetry
# endpoint, and no Highflame account involved in running this stack.

# ============================================================================
# The address other machines reach this host by. An IP is fine and is the normal
# choice; a hostname works too if you already have DNS for it, but nothing here
# requires one.
#
# NOT 127.0.0.1, and the reason is worth stating because the failure names
# nothing. Two separate things break:
#
#   * Signing in from any other machine fails, since the Keycloak realm's
#     redirect URIs are built from this value.
#   * Token verification fails even ON this host. Admin FETCHES OpenID metadata
#     from the issuer URL, which is built from this value, and it does so from
#     inside its own container — where 127.0.0.1 is Admin. Every authenticated
#     call then returns a bare
#         401 {"error":"Invalid token"}
#     with the token's iss, aud, sub and exp all correct and only the signature
#     uncheckable, because the keys could not be fetched.
#
# So this must be an address a container can route to: the host's LAN address,
# or on a single-machine Linux setup a bridge address that is not the app
# network's own gateway.
#
# On Docker Desktop (macOS, Windows) use the machine's LAN address — the one
# `ipconfig` (Windows) or System Settings > Network (macOS) shows. Containers
# there reach it, and through it the port nginx publishes.
#
# Bootstrap requires this (or HIGHFLAME_HOSTNAME); a realm with the wrong origin
# fails login with invalid_redirect_uri rather than anything that names the
# cause.
#
# Everything the browser touches — Studio, Admin, Keycloak — is served from this
# one origin through the bundled nginx on :80. That is deliberate: a browser
# talking to several ports is several origins, which means CORS, which is what
# breaks behind a corporate proxy.
#
#   HIGHFLAME_HOST_IP=10.0.0.42
HIGHFLAME_HOST_IP=
# CONN_PROTOCOL=https

# REQUIRED — you must set
# ============================================================================
# Your own LLM endpoint, inside your network. This is the one thing the stack
# talks to that isn't part of the stack, because a gateway that inspects LLM
# traffic has to be able to reach the LLM.
#
# Anything OpenAI-API-compatible: vLLM, TGI, Ollama, LM Studio, Azure OpenAI,
# Bedrock behind a VPC endpoint, or your own gateway. NOT a public endpoint —
# the evaluation is designed to work without one.
#
# Examples:
#   HIGHFLAME_LLM_BASE_URL=http://vllm.internal:8000/v1
#   HIGHFLAME_LLM_BASE_URL=https://my-aoai.privatelink.openai.azure.com/openai
HIGHFLAME_LLM_BASE_URL=
HIGHFLAME_LLM_API_KEY=


# ============================================================================
# OPTIONAL
# ============================================================================

# Pins the compose project name. verify/no-egress.sh calls `docker compose`
# without -p, so without this it silently targets a different project if you
# brought the stack up with one — and `docker compose exec` against a service
# that is not in the project prints a message and exits 0, which reads as
# success.
#
# It also fixes the network and volume names the docs refer to.
COMPOSE_PROJECT_NAME=highflame-airgap

# bootstrap.yaml runs in the same project as the stack, because it reads the
# stack's database volume to refuse a destructive --force. Compose therefore
# sees the running stack's containers as "orphans" of bootstrap.yaml and
# suggests --remove-orphans, which would delete them. Nothing in this bundle is
# ever an orphan in the sense that warning means, so it is switched off.
COMPOSE_IGNORE_ORPHANS=true

# Per-service image tags, so one service can be pinned without moving the rest.
# HIGHFLAME_ADMIN_IMG_VERSION=latest
# HIGHFLAME_AUTHN_IMG_VERSION=latest
# HIGHFLAME_AUTHZ_IMG_VERSION=latest
# HIGHFLAME_SHIELD_IMG_VERSION=latest
# HIGHFLAME_COLLECTOR_IMG_VERSION=latest
# HIGHFLAME_CERBERUS_IMG_VERSION=latest
# HIGHFLAME_OBS_IMG_VERSION=latest
# HIGHFLAME_FIREHOG_IMG_VERSION=latest
# HIGHFLAME_STUDIO_IMG_VERSION=latest
# HIGHFLAME_FLAG_IMG_VERSION=latest

# Issuer Shield expects on Admin-minted RS256 tokens. Must match what AuthN
# stamps. Only change this if you front AuthN with a different hostname.
HIGHFLAME_AUTH_JWT_ISSUER=http://highflame-authn:8051

# In-stack service URLs, needed when bootstrap renders Firehog's config.
# Change only if you rename services.
HIGHFLAME_SHIELD_URL=http://highflame-shield:8070/v1/shield
HIGHFLAME_AUTHN_URL=http://highflame-authn:8051

# ML detector endpoints. This stack ships WITHOUT the four model servers — they
# are large and GPU-shaped, and not needed to evaluate the platform — so Shield
# runs with its ML detectors unavailable. Its heuristic detectors and Cedar
# policy enforcement are unaffected; the README says exactly what that leaves.
#
# The hosted product points these at guard.gpu-models.highflame.ai, which would
# send prompt content out of your network to be scored. Here they point at names
# that cannot resolve, so failure is guaranteed and egress is impossible. Leave
# them alone unless you are adding the model servers back, in which case set them
# to the real in-stack addresses (ports 8013 / 8014 / 8018 / 8022 respectively).
HIGHFLAME_GUARD_URL=http://highflame-guard.disabled.invalid:8013
HIGHFLAME_GUARD_CM_URL=http://highflame-guard-cm.disabled.invalid:8014
HIGHFLAME_GUARD_PII_URL=http://highflame-guard-pii.disabled.invalid:8018
HIGHFLAME_GUARD_DEEPCONTEXT_URL=http://highflame-guard-deepcontext.disabled.invalid:8022

# ============================================================================
# GENERATED — `docker compose -f bootstrap.yaml run --rm bootstrap` fills these in.
# Do not commit a filled-in .env.
# ============================================================================

POSTGRES_USER=highflame
POSTGRES_DB=javelin_data
POSTGRES_PASSWORD=

CLICKHOUSE_USER=highflame
CLICKHOUSE_DB=highflame
CLICKHOUSE_PASSWORD=

# Keycloak's own admin console (http://<host>/auth/admin). Only needed if you
# want to add users or inspect the realm; the evaluation does not require it.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=

# Must match the client secret in config/keycloak/highflame-realm.json.
# bootstrap generates one value and writes it to both, so they cannot drift.
OIDC_CLIENT_SECRET=

# The evaluator account's password, also written into the realm by bootstrap.
# Username is `evaluator`.
EVALUATOR_PASSWORD=

# Auth.js session cookie signing key for Studio (32+ bytes).
AUTH_SECRET=

# Platform secrets. HIGHFLAME_AUTH_JWT_SECRET_KEY and
# HIGHFLAME_TOKEN_ENCRYPTION_KEY must both be at least 32 bytes — AuthN fails
# closed at startup on a short key rather than starting up weak.
HIGHFLAME_AUTH_JWT_SECRET_KEY=
HIGHFLAME_TOKEN_ENCRYPTION_KEY=
HIGHFLAME_INTERNAL_SERVICE_SECRET=
# Shared secret for Shield -> detector-model calls. Both sides are in this stack.
HIGHFLAME_MODELS_SECRET=
